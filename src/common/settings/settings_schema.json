{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZhixuIME settings",
  "type": "object",
  "required": ["version"],
  "properties": {
    "version": { "const": 1 },
    "privacy_mode": { "type": "boolean" },
    "learning_enabled": { "type": "boolean" },
    "prediction_enabled": { "type": "boolean" },
    "tab_accept_enabled": { "type": "boolean" },
    "candidate_count": { "type": "integer", "minimum": 1, "maximum": 9 },
    "theme": { "enum": ["system", "light", "dark"] },
    "fuzzy_pinyin": { "type": "boolean" },
    "excluded_app_hashes": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
