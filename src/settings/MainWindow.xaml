<Window x:Class="ZhixuIME.Settings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZhixuIME 设置" Height="540" Width="820" WindowStartupLocation="CenterScreen">
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <TabControl>
      <TabItem Header="常规"><StackPanel Margin="16"><CheckBox Content="启用模糊拼音" IsChecked="{Binding FuzzyPinyin}" /><CheckBox Content="按 Tab 接受首条推荐" IsChecked="{Binding TabAcceptEnabled}" /><TextBlock Margin="0,16,0,4" Text="紧凑候选数量（展开后仍为每行6项）" />
      <ComboBox Width="100" HorizontalAlignment="Left" ItemsSource="{Binding CandidateCounts}" SelectedItem="{Binding CandidateCount}"/>
      <TextBlock Margin="0,16,0,4" Text="候选和推荐窗口主题" />
      <ComboBox Width="140" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectedValue="{Binding Theme}"><ComboBoxItem Content="跟随系统" Tag="system"/><ComboBoxItem Content="浅色" Tag="light"/><ComboBoxItem Content="深色" Tag="dark"/></ComboBox></StackPanel></TabItem>
      <TabItem Header="隐私"><StackPanel Margin="16"><CheckBox Content="隐私模式" IsChecked="{Binding PrivacyMode}" /><CheckBox Content="本地学习" IsChecked="{Binding LearningEnabled}" /><CheckBox Content="智能推荐" IsChecked="{Binding PredictionEnabled}" /></StackPanel></TabItem>
      <TabItem Header="排除应用"><StackPanel Margin="16"><TextBlock Text="选择不学习、不推荐的程序；仍可正常拼音输入。程序升级后请重新选择。" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,10"><Button Content="添加程序…" Click="AddExcluded_Click" Padding="12,4"/><Button Content="移除所选" Click="RemoveExcluded_Click" Margin="10,0,0,0" Padding="12,4"/></StackPanel>
        <ListBox ItemsSource="{Binding ExcludedAppHashes}" SelectedItem="{Binding SelectedExcludedHash}" Height="220"/>
        <TextBlock Margin="0,8,0,0" Text="保存设置后生效；列表仅保存程序文件的 SHA-256，不保存程序路径。" TextWrapping="Wrap"/>
      </StackPanel></TabItem>
      <TabItem Header="语料包"><Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="选择资料包目录可一次安装全部分类；也可以按分卷单独管理。" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,8" IsEnabled="{Binding CanManagePackages}">
          <Button Content="安装全部分类" Click="InstallFolder_Click" Padding="10,4"/>
          <Button Content="安装资料包 / 升级" Click="InstallPackages_Click" Padding="10,4" Margin="8,0,0,0"/>
          <Button Content="刷新" Click="RefreshPackages_Click" Padding="10,4" Margin="8,0,0,0"/>
        </StackPanel>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False">
          <DataGrid.Columns><DataGridTextColumn Header="资料包" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="90"/><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="70"/></DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0" IsEnabled="{Binding CanManagePackages}">
          <Button Content="启用" Click="EnablePackage_Click" Padding="12,4"/><Button Content="停用" Click="DisablePackage_Click" Padding="12,4" Margin="8,0,0,0"/><Button Content="卸载" Click="RemovePackage_Click" Padding="12,4" Margin="8,0,0,0"/>
        </StackPanel>
      </Grid></TabItem>
      <TabItem Header="数据"><StackPanel Margin="16"><TextBlock Text="清除学习数据不会移除已安装的语料包。" /><Button Margin="0,12,0,0" Width="130" HorizontalAlignment="Left" Content="清除学习数据" Click="ClearLearning_Click" /></StackPanel></TabItem>
      <TabItem Header="诊断"><StackPanel Margin="16"><TextBlock Text="诊断导出只包含事件编号、数值和状态码，不包含输入原文。" /><Button Margin="0,12,0,0" Width="130" HorizontalAlignment="Left" Content="导出诊断" Click="ExportDiagnostics_Click" /></StackPanel></TabItem>
    </TabControl>
    <StackPanel Grid.Row="1" Orientation="Horizontal"><Button Width="100" Content="保存设置" Click="SaveSettings_Click" /><TextBlock Margin="12,4,0,0" Text="{Binding Status}" /></StackPanel>
  </Grid>
</Window>
