if(NOT DEFINED LIBRIME_SOURCE_DIR)
  message(FATAL_ERROR "LIBRIME_SOURCE_DIR is required")
endif()

set(file "${LIBRIME_SOURCE_DIR}/src/CMakeLists.txt")
file(READ "${file}" contents)
set(before "include(\${CMAKE_SOURCE_DIR}/cmake/AddRCInfo.cmake)")
set(after "include(\${PROJECT_SOURCE_DIR}/cmake/AddRCInfo.cmake)")
string(FIND "${contents}" "${before}" position)
if(position EQUAL -1)
  string(FIND "${contents}" "${after}" already_patched)
  if(already_patched EQUAL -1)
    message(FATAL_ERROR "Expected librime AddRCInfo source-root expression was not found")
  endif()
  return()
endif()
string(REPLACE "${before}" "${after}" contents "${contents}")
file(WRITE "${file}" "${contents}")
