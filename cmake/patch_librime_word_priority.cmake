if(NOT DEFINED LIBRIME_SOURCE_DIR)
  message(FATAL_ERROR "LIBRIME_SOURCE_DIR is required")
endif()
set(path "${LIBRIME_SOURCE_DIR}/src/rime/gear/script_translator.cc")
file(READ "${path}" content)
foreach(table IN ITEMS "phrase_")
  if(table STREQUAL "phrase_")
    set(iterator "phrase_iter_")
  else()
    set(iterator "user_phrase_iter_")
  endif()
  set(before "has_exact_match_phrase(${table}, ${iterator}, consumed) &&\n      !is_correction_match(*${iterator}, consumed)")
  set(after "has_exact_match_phrase(${table}, ${iterator}, consumed)")
  string(FIND "${content}" "${before}" position)
  if(NOT position EQUAL -1)
    string(REPLACE "${before}" "${after}" content "${content}")
  else()
    string(FIND "${content}" "${after};" patched)
    if(patched EQUAL -1)
      message(FATAL_ERROR "Unexpected pinned librime complete-word policy")
    endif()
  endif()
endforeach()
# Learned phrases reached only through fuzzy corrections must not suppress
# exact-spelling context decoding. Restore upstream policy in r18 build trees.
set(user_before "has_exact_match_phrase(user_phrase_, user_phrase_iter_, consumed);")
set(user_after "has_exact_match_phrase(user_phrase_, user_phrase_iter_, consumed) &&\n      !is_correction_match(*user_phrase_iter_, consumed);")
string(REPLACE "${user_before}" "${user_after}" content "${content}")
string(FIND "${content}" "${user_after}" user_policy)
if(user_policy EQUAL -1)
  message(FATAL_ERROR "Unexpected pinned librime learned-phrase policy")
endif()
file(WRITE "${path}" "${content}")
