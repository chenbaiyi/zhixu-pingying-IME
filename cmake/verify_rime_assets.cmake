# Read immutable upstream hashes from the same manifest used for attribution.
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/third_party.lock.json" asset_lock)
string(JSON asset_count LENGTH "${asset_lock}" assets)
math(EXPR last_asset "${asset_count} - 1")
foreach(asset_index RANGE 0 ${last_asset})
  string(JSON asset_name GET "${asset_lock}" assets ${asset_index} name)
  if(NOT asset_name STREQUAL "rime-pinyin-simp" AND NOT asset_name STREQUAL "rime-wanxiang")
    continue()
  endif()
  string(JSON file_count LENGTH "${asset_lock}" assets ${asset_index} files)
  math(EXPR last_file "${file_count} - 1")
  foreach(file_index RANGE 0 ${last_file})
    string(JSON asset_path GET "${asset_lock}" assets ${asset_index} files ${file_index} path)
    string(JSON expected_hash GET "${asset_lock}" assets ${asset_index} files ${file_index} sha256)
    file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/${asset_path}" actual_hash)
    if(NOT actual_hash STREQUAL expected_hash)
      message(FATAL_ERROR "Pinned Rime asset hash mismatch: ${asset_path}")
    endif()
  endforeach()
  if(asset_name STREQUAL "rime-pinyin-simp")
    set(zhixu_full_pinyin_verified TRUE)
  else()
    set(zhixu_wanxiang_verified TRUE)
  endif()
endforeach()
if(NOT zhixu_full_pinyin_verified)
  message(FATAL_ERROR "Pinned rime-pinyin-simp asset record is required")
endif()

if(NOT zhixu_wanxiang_verified)
  message(FATAL_ERROR "Pinned rime-wanxiang asset record is required")
endif()
