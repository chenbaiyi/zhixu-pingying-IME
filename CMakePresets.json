{
  "version": 6,
  "configurePresets": [
    {
      "name": "x64-debug",
      "generator": "Ninja",
      "binaryDir": "$env{ZHIXU_BUILD_ROOT}/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "VCPKG_HOST_TRIPLET": "x64-windows-static",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
        "BUILD_TESTING": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests;settings;prediction"
      }
    },
    {"name":"x64-release","inherits":"x64-debug","binaryDir":"$env{ZHIXU_BUILD_ROOT}/${presetName}","cacheVariables":{"CMAKE_BUILD_TYPE":"Release"}},
    {"name":"x64-debug-librime","inherits":"x64-debug","binaryDir":"$env{ZHIXU_BUILD_ROOT}/${presetName}","cacheVariables":{"VCPKG_MANIFEST_FEATURES":"tests;prediction;librime","ZHIXU_ENABLE_LIBRIME":"ON"}}
  ],
  "buildPresets": [
    {"name":"x64-debug","configurePreset":"x64-debug"},
    {"name":"x64-release","configurePreset":"x64-release"},
    {"name":"x64-debug-librime","configurePreset":"x64-debug-librime"}
  ],
  "testPresets": [
    {"name":"x64-debug","configurePreset":"x64-debug","output":{"outputOnFailure":true},"execution":{"noTestsAction":"error","timeout":30}},
    {"name":"x64-release","configurePreset":"x64-release","output":{"outputOnFailure":true},"execution":{"noTestsAction":"error","timeout":30}},
    {"name":"x64-debug-librime","configurePreset":"x64-debug-librime","output":{"outputOnFailure":true},"execution":{"noTestsAction":"error","timeout":30}}
  ]
}
